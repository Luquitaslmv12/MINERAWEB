# Credenciales de EmailJS usadas por el formulario de contacto.
# Copiá este archivo como `.env` y completá los valores reales.
# Si no se definen, la app usa los valores por defecto de src/data/site.js.

VITE_EMAILJS_SERVICE_ID=service_xxxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx
